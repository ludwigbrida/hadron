{
  "pre-commit": {
    "jobs": [
      {
        "name": "format",
        "run": "npm exec --no -- prettier --write --ignore-unknown {staged_files}",
        "stage_fixed": true
      }
    ]
  },
  "commit-msg": {
    "jobs": [
      {
        "name": "message",
        "run": "npm exec --no -- commitlint --edit {1}"
      }
    ]
  }
}
